# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Pipeline intermediate files (per-batch inputs to apply_*.py scripts —
# editorial decisions are recorded in the resulting commit, not in the
# batch JSON, so these stay local-only).
scripts/drafts_batch*.json
scripts/drafts_*.json
scripts/summaries_hu_*.json
scripts/bios_hu.json
scripts/backfill_instruments.json
*.draft.txt

# Author-submission archive (local-only record after processing)
submissions/DONE/

# Generated per-author markdown exports (rebuild via scripts/export_author_md.py)
exports/

# Transient DOI-fix scratch files
pdf-lists/doi-fixes-proposed.json

# Local config / secrets
.env
.env.local
*.pem
*.key

# Local-only content: PII (emails), author dossiers, editor scratch.
# Never committed. Back up separately if needed.
not-shared/

# Author outreach dossiers. Regenerate any time with
# `python scripts/generate_dossier.py <author_id>`.
outreach/

# Node (if ever added)
node_modules/

# Odd files Windows tools sometimes create
nul

# OS-specific scratch
~*
